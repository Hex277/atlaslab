// Share of the login-promo slot given over to the weekly practice / projects promo.
var PROMO_SHARE = 0.33;

// Weekly practice problem or beginner project, rendered with the same showcase unit
// as the tools slot. Sits in the login-promo slot, not the tools slot.
// Parked: no slot in the current 25/75 mix calls this.
function displayPromoShowcase() {
  var showcaseLink = document.getElementById("upperfeatureshowcaselink");
  if (!showcaseLink || document.getElementById("tools-catalog-ad")) {
    return;
  }
  var ad = document.createElement("div");
  ad.id = "tools-catalog-ad";
  ad.style.cssText = "width:100%;max-width:300px;display:flex;justify-content:center;";
  showcaseLink.parentNode.insertBefore(ad, showcaseLink.nextSibling);

  function go() {
    if (window.WsToolsShowcase) {
      window.WsToolsShowcase.mountPromo(ad, "auto", "auto", { gaClass: "ga-2026-promo" });
    }
  }
  if (window.WsToolsShowcase) { go(); return; }
  var s = document.createElement("script");
  s.src = "/tools/showcase.js?v=1.0";
  s.async = true;
  s.onload = go;
  document.head.appendChild(s);
}

// Parked: no slot in the current 25/75 mix calls this.
function displayToolsAd() {
  var showcaseLink = document.getElementById("upperfeatureshowcaselink");
  if (!showcaseLink || document.getElementById("tools-catalog-ad")) {
    return;
  }

  // Rotating tools showcase (/tools/showcase.js). It cycles the whole tools catalogue -
  // screenshot, name and tagline - and links straight to each tool page. The "auto"
  // format tracks the same 990 / 1260 / 1700 breakpoints as the <source media> rules
  // above, so the card keeps the slot's footprint (300 / 120 / 160) at every width.
  var ad = document.createElement("div");
  ad.id = "tools-catalog-ad";
  // The unit is a fixed width (120 / 160 / 300) while the rail is wider, so centre it -
  // the card this replaced was width:100% and filled the rail on its own.
  ad.style.cssText = "width:100%;max-width:300px;display:flex;justify-content:center;";
  showcaseLink.parentNode.insertBefore(ad, showcaseLink.nextSibling);

  function mountShowcase() {
    if (window.WsToolsShowcase) {
      window.WsToolsShowcase.mount(ad, "auto", { gaClass: "ga-2026-tools" });
    }
  }

  if (window.WsToolsShowcase) {
    mountShowcase();
    return;
  }
  // Loaded on demand: this slot is one of six, so most page views never pay for it.
  var s = document.createElement("script");
  s.src = "/tools/showcase.js?v=1.0";
  s.async = true;
  s.onload = mountShowcase;
  document.head.appendChild(s);
}
